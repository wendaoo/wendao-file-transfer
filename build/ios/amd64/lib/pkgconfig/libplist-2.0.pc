prefix=@@HOMEBREW_CELLAR@@/libplist/2.4.0
exec_prefix=${prefix}
libdir=@@HOMEBREW_CELLAR@@/libplist/2.4.0/lib
includedir=${prefix}/include

Name: libplist
Description: A library to handle Apple Property Lists whereas they are binary or XML
Version: 2.4.0
Libs: -L${libdir} -lplist-2.0
Cflags: -I${includedir}
