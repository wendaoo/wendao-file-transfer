prefix=@@HOMEBREW_CELLAR@@/libplist/2.4.0
exec_prefix=${prefix}
libdir=@@HOMEBREW_CELLAR@@/libplist/2.4.0/lib
includedir=${prefix}/include

Name: libplist++
Description: C++ binding for libplist
Version: 2.4.0
Libs: -L${libdir} -lplist++-2.0
Cflags: -I${includedir}
Requires.private: libplist-2.0 >= 2.4.0
